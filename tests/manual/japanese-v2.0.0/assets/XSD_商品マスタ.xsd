<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="商品一覧">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="商品" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="商品名" type="xs:string"/>
              <xs:element name="単価" type="xs:int"/>
              <xs:element name="数量" type="xs:int"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
