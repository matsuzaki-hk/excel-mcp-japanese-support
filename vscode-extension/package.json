{
  "name": "excel-mcp-ja",
  "displayName": "ExcelMcp 日本語対応フォーク",
  "description": "ExcelMcp の日本語対応フォーク。日本語テーブル名・シート名・ファイルパスをサポートし、日本語 skill を同梱します。Excel デスクトップ版が必要です。",
  "version": "2.2.1",
  "publisher": "matsuzaki-hk",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matsuzaki-hk/excel-mcp-japanese-support"
  },
  "bugs": {
    "url": "https://github.com/matsuzaki-hk/excel-mcp-japanese-support/issues"
  },
  "homepage": "https://matsuzaki-hk.github.io/excel-mcp-japanese-support/",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "os": [
    "win32"
  ],
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Chat",
    "Data Science"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "excel",
    "microsoft",
    "office",
    "spreadsheet",
    "automation",
    "power query",
    "m language",
    "dax",
    "data model",
    "power pivot",
    "vba",
    "macro",
    "table",
    "copilot",
    "ai",
    "github copilot",
    "data analysis",
    "excel automation",
    "pivot tables",
    "charts",
    "python in excel",
    "m code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "excel-mcp-ja",
        "label": "ExcelMcp 日本語対応フォーク"
      }
    ],
    "chatSkills": [
      {
        "name": "excel-mcp-ja",
        "description": "ExcelMcp 日本語対応フォークの skill。Windows 版 Excel 操作を支援します。",
        "path": "./skills/excel-mcp-ja/SKILL.md"
      },
      {
        "name": "excel-mcp-report-formatting",
        "description": "Optional presentation conventions for requested Excel reports.",
        "path": "./skills/excel-mcp-report-formatting/SKILL.md"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "validate:features": "node scripts/validate-feature-metadata.mjs",
    "compile": "npm run validate:features && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pwsh -NoProfile -File ..\\scripts\\Build-ReleasePackages.ps1 -Components Extension",
    "lint": "oxlint src tests -D correctness -D suspicious -D perf --deny-warnings",
    "test": "vitest run",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^4.0.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^14.0.1"
  }
}
